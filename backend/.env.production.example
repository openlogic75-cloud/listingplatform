# Production environment for Hostinger shared hosting (M8.4).
# Copy to backend/.env on the host and fill in every value.
# NEVER commit real secrets.

APP_NAME="Shekuthi"
APP_ENV=production
APP_KEY=                 # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://shekuthi.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Branding (M0.7). The name, tagline and logo files are read from here, so a
# rebrand is an .env edit plus dropping files in public/img/ - no code change.
BRAND_NAME="Shekuthi"
BRAND_TAGLINE="Local goods, honest sourcing, direct connections."
SOURCE_REPO_URL="https://github.com/openlogic75-cloud/listingplatform"

LOG_CHANNEL=stack
LOG_LEVEL=warning

# hPanel-created database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<panel-db-name>
DB_USERNAME=<panel-db-user>
DB_PASSWORD=<panel-db-password>

# Hostinger-compatible: database drivers, no Redis, no long-lived queue workers.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Media on the public disk; swap to S3-compatible later (Q9).
FILESYSTEM_DISK=public

# Set to the app domain(s) that open cookie-authed state; API uses tokens.
SANCTUM_STATEFUL_DOMAINS=shekuthi.in,www.shekuthi.in

# Keep disabled until the retention command has been dry-run and cron is
# confirmed in hPanel. Then set true and add the scheduler cron entry.
APP_CRON_ENABLED=false

# Key for blind-index HMAC hashes that make encrypted PII searchable.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
PII_INDEX_KEY=

# Legacy FCM server key. Empty disables push (in-app inbox still works).
FCM_SERVER_KEY=

# SMTP is required if email notifications are enabled. Do not use the log
# mailer in a public production environment when users expect email.
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@shekuthi.in
MAIL_FROM_NAME="Shekuthi"

# Legal identity is required before the public launch; do not leave these
# placeholders in production.
LEGAL_ENTITY_NAME=<legal-entity-name>
LEGAL_ADDRESS=<legal-address>
LEGAL_CONTACT_EMAIL=contact@shekuthi.in
GRIEVANCE_OFFICER_NAME="K Hika Zhimomi"
GRIEVANCE_OFFICER_EMAIL=contact@shekuthi.in
LEGAL_JURISDICTION="Nagaland, India"
LEGAL_EFFECTIVE_DATE=<effective-date>
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_VERSION=1.0
LEGAL_CONSENT_VERSION=1.0
