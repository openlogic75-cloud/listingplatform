APP_NAME="Local Goods Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Branding (M0.7). Product name, tagline and logo files. A rebrand is an .env
# edit plus dropping files into public/img/ - never a code change.
BRAND_NAME="Local Goods Marketplace"
BRAND_TAGLINE="Local goods, honest sourcing, direct connections."

# Public source repository shown on the About page (M29.1).
SOURCE_REPO_URL="https://github.com/openlogic75-cloud/listingplatform"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listingplatform
DB_USERNAME=listingplatform
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Key used to derive blind-index hashes for encrypted PII lookups (email, phone).
# Generate with: php -r "echo bin2hex(random_bytes(32));"
PII_INDEX_KEY=

# Firebase Cloud Messaging server key (used from milestone M8.1 onward).
FCM_SERVER_KEY=
